{{- /* The design's pages in one language, from docs/design/ as
  web/hugo.toml mounts it: README.md as design/, the section's own page
  (path "."; the empty path is the home page's), each other file as
  design/<name>/, in the order of the README's list of contents, which
  also names them in the sidebar. A Chinese page reads docs/design/zh/
  and, where a file has no translation yet, the English one, under a
  note (layouts/design/all.html). The first line of a translation, the
  SHA-256 of the English file (check-design-translation), is dropped; so
  is each file's `# ` title, which becomes the page's. A translation's
  heading carries its English anchor, `## <a id="checks"></a>检查`,
  which becomes the heading's id. The pages are hidden from the theme's
  own list (bookHidden), as the menu lists them. The page's params keep
  the directory of the file it read, against which
  layouts/_markup/render-link.html resolves its links. It runs once for each language of the site. */ -}}
{{- .EnableAllLanguages }}
{{- $lang := .Site.Language.Lang }}
{{- $readme := partial "design/source.html" (dict "name" "README.md" "lang" $lang) }}
{{- $contents := findRESubmatch `(?m)^- \[([^\]]+)\]\(([\w-]+)\.md\)` $readme.text.Content }}
{{- $files := slice (slice "" "README") }}
{{- $listed := slice "README" }}
{{- range $contents }}
  {{- $files = $files | append (slice (index . 1) (index . 2)) }}
  {{- $listed = $listed | append (index . 2) }}
{{- end }}
{{- $english := slice }}
{{- range resources.Match "design/*.md" }}
  {{- $english = $english | append (strings.TrimSuffix ".md" (path.Base .Name)) }}
{{- end }}
{{- if not (eq (sort $listed) (sort $english)) }}
  {{- errorf "docs/design/README.md lists %v besides itself, docs/design/ has %v" (after 1 $listed) $english }}
{{- end }}
{{- range $i, $file := $files }}
  {{- $name := index $file 1 }}
  {{- $source := partial "design/source.html" (dict "name" (printf "%s.md" $name) "lang" $lang) }}
  {{- $text := $source.text.Content }}
  {{- if $source.translated }}
    {{- $text = replaceRE `^<!--.*-->\n` "" $text }}
    {{- $text = replaceRE `(?m)^(#{2,6}) <a id="([^"]+)"></a>(.*)$` "$1 $3 {#$2}" $text }}
  {{- end }}
  {{- $title := index (findRESubmatch `^# (.+)\n` $text 1) 0 1 }}
  {{- $page := dict
    "kind" (cond (eq $name "README") "section" "page")
    "path" (cond (eq $name "README") "." $name)
    "title" $title
    "params" (dict "designDir" $source.dir "translated" $source.translated "bookHidden" true)
    "content" (dict "mediaType" "text/markdown" "value" (replaceRE `^# .+\n` "" $text))
  }}
  {{- with index $file 0 }}
    {{- $page = merge $page (dict "menus" (dict "before" (dict "parent" "design" "name" . "weight" $i))) }}
  {{- end }}
  {{- $.AddPage $page }}
{{- end }}
