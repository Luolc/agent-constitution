{{- /* The pages of one language from the built constitution: its full
  version, constitution.<lang>.md, as the home page and again as
  editions/<edition>/, the address of this edition that a later one does
  not take, and its version for agents, constitution.<lang>.agent.md, as
  agent/ (both found by
  layouts/_partials/constitution/source.html). The full version
  starts with the build's header line, a blank line and the `# ` title,
  the version for agents with the title: the header line is dropped, the
  title becomes the page's, and the layouts set it above the text
  (layouts/home.html, layouts/page.html). The page's params hold the
  length of the text the page gives, the file from its title on: its
  characters, its words split on white space
  and its SHA-256, which tells whether data/lengths.json counted this
  text. It runs once for each language of the site. */ -}}
{{- .EnableAllLanguages }}
{{- $lang := .Site.Language.Lang }}
{{- $pages := dict }}
{{- range $version := slice "" ".agent" }}
  {{- $file := printf "constitution.%s%s.md" $lang $version }}
  {{- $markdown := (partial "constitution/source.html" $file).Content }}
  {{- $lines := split $markdown "\n" }}
  {{- if eq $version "" }}
    {{- if or (lt (len $lines) 3) (not (strings.Contains (index $lines 0) "constitution build")) (not (strings.HasPrefix (index $lines 2) "# ")) }}
      {{- errorf "constitution/%s: does not start with the build's header line, a blank line and the `# ` title" $file }}
    {{- end }}
    {{- $lines = after 2 $lines }}
  {{- else if not (strings.HasPrefix (index $lines 0) "# ") }}
    {{- errorf "constitution/%s: does not start with the `# ` title" $file }}
  {{- end }}
  {{- $text := delimit $lines "\n" }}
  {{- $pages = merge $pages (dict (cond (eq $version "") "full" "agent") (dict
    "title" (strings.TrimPrefix "# " (index $lines 0))
    "body" (delimit (after 1 $lines) "\n")
    "length" (dict
      "characters" (strings.RuneCount $text)
      "words" (len (findRE `\S+` $text))
      "sha256" (sha256 $text)
      "omitted" (strings.Contains $text site.Params.omittedMark)
    )
  )) }}
{{- end }}
{{- /* The full version's headings carry their anchor, `## <a
  id="general-provisions"></a>Article I. ...`; it becomes the heading's id,
  so the table of contents links to it. The version for agents has no
  anchors; `{anchor=false}` keeps the theme's `#` link off its headings. */ -}}
{{- $full := $pages.full }}
{{- /* Under each provision that rules cite in their `authority`, those
  rules (data/rules.json, which content/rules/_content.gotmpl requires),
  folded into a row of their labels that opens a list of them linked to
  their pages (layouts/_partials/rules/cites.html); an article that
  rules cite through a provision under it gets instead the count of the
  rules that cite it or a provision under it, which opens the list of
  them all, so that its line holds one button. A paragraph after an
  article's heading, or a line ending the first line of a section or an
  item, which the style sheet sets on a line of its own. The lengths
  above are of the text without them. */ -}}
{{- $body := $full.body }}
{{- with index (hugo.Data.rules | default dict) $lang }}
  {{- $citedBy := .citedBy }}
  {{- $citedWithin := .citedWithin }}
  {{- range $ref, $_ := merge $citedWithin $citedBy }}
    {{- $direct := index $citedBy $ref | default slice }}
    {{- $within := index $citedWithin $ref | default slice }}
    {{- $line := "" }}
    {{- if gt (len $within) (len $direct) }}
      {{- $line = partial "rules/cites.html" (dict "id" (printf "cites-within-%s" $ref) "rules" $within "name" "" "text" (i18n "cited-within" (len $within))) }}
    {{- else if $direct }}
      {{- $line = partial "rules/cites.html" (dict "id" (printf "cites-%s" $ref) "rules" $direct "name" (i18n "cited-by" (len $direct)) "text" "") }}
    {{- end }}
    {{- $line = replace $line "$" "$$" }}
    {{- $anchor := printf `<a id="%s"></a>` (replace $ref "." `\.`) }}
    {{- $body = replaceRE (printf `(?m)^(#{2,6} %s.*)$` $anchor) (printf `$1%s<p class="cited-by">%s</p>` "\n\n" $line) $body }}
    {{- $body = replaceRE (printf `(?m)^( *-   %s.*)$` $anchor) (printf `$1 <span class="cited-by">%s</span>` $line) $body }}
  {{- end }}
{{- end }}
{{- /* In the sidebar, the full version is the edition it belongs to, under
  the constitution, named and marked from its index.toml. The
  editions are listed newest first: the weight is the edition's year and
  month, negated. */ -}}
{{- $index := partial "constitution/index.html" . }}
{{- $edition := $index.edition }}
{{- $name := i18n "edition" (dict "edition" $edition) }}
{{- if eq $index.status "draft" }}
  {{- $name = printf "%s %s" $name (i18n "draft") }}
{{- end }}
{{- $page := dict
  "title" $full.title
  "params" (dict "length" $full.length "agentLength" $pages.agent.length)
  "content" (dict
    "mediaType" "text/markdown"
    "value" (replaceRE `(?m)^(#{2,6}) <a id="([^"]+)"></a>(.*)$` "$1 $3 {#$2}" $body)
  )
}}
{{- .AddPage (merge $page (dict
  "kind" "home"
  "path" "/"
  "menus" (dict "before" (dict
    "parent" "constitution"
    "name" $name
    "weight" (sub 0 (int (replace $edition "-" "")))
  ))
)) }}
{{- /* The edition's page, the home page's text at an address of its own
  (layouts/editions/page.html), hidden from the theme's list and kept
  out of search engines' index (layouts/_partials/docs/inject/head.html),
  as the home page has the same text. Their section, editions/, gets no
  page of its own. */ -}}
{{- .AddPage (dict
  "kind" "section"
  "path" "editions"
  "title" "editions"
  "params" (dict "bookHidden" true)
  "build" (dict "render" "never" "list" "never")
) }}
{{- .AddPage (merge $page (dict
  "path" (printf "editions/%s" $edition)
  "params" (merge $page.params (dict "bookHidden" true "noindex" true))
)) }}
{{- .AddPage (dict
  "path" "agent"
  "title" $pages.agent.title
  "params" (dict "bookHidden" true)
  "content" (dict
    "mediaType" "text/markdown"
    "value" (replaceRE `(?m)^(#.*)$` "$1 {anchor=false}" $pages.agent.body)
  )
) }}
